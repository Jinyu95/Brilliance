# === Brilliance coding agent + selectable inference backend ===
# DeepSeek is the default model service and the old LLM_* settings are
# intentionally reused. OpenAI uses Codex; other listed providers use the
# compact native function-calling loop.
BRILLIANCE_CODEX_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Codex compacts before this backend limit instead of injecting complete
# numerical history into every request.
BRILLIANCE_CODEX_CONTEXT_WINDOW=128000

# Fail model transport problems quickly. These limits apply only to the remote
# model stream, never to JuTrack or managed optimization workers.
BRILLIANCE_MODEL_REQUEST_RETRIES=1
BRILLIANCE_MODEL_STREAM_RETRIES=1
BRILLIANCE_MODEL_STREAM_IDLE_TIMEOUT_S=120

# Accelerator runtime paths are declared in this TOML file. Relative paths are
# resolved from the Brilliance source root; the agent never searches for them.
BRILLIANCE_RUNTIME_CONFIG=brilliance/config/research_runtime.toml

# Fully offline alternative (uncomment one provider and set a loaded model):
# BRILLIANCE_CODEX_PROVIDER=ollama
# BRILLIANCE_CODEX_MODEL=deepseek-r1:14b
# OLLAMA_MODEL=deepseek-r1:14b
#
# BRILLIANCE_CODEX_PROVIDER=lmstudio
# BRILLIANCE_CODEX_MODEL=your-loaded-model-id
# LMSTUDIO_MODEL=your-loaded-model-id

# A custom OpenAI-compatible provider may use:
# BRILLIANCE_CODEX_PROVIDER=custom
# BRILLIANCE_CODEX_PROVIDER_NAME=Internal model service
# BRILLIANCE_CODEX_PROVIDER_ID=internal
# BRILLIANCE_CODEX_BASE_URL=http://model-host:8000/v1
# BRILLIANCE_CODEX_API_KEY_ENV=INTERNAL_MODEL_API_KEY
# BRILLIANCE_CODEX_MODEL=model-id

# low | medium | high | xhigh. Used by backends that support this Codex option;
# DeepSeek and offline models use their native reasoning behavior.
BRILLIANCE_CODEX_EFFORT=high

# Wall-clock budget for model reasoning in one research increment. Reaching it
# checkpoints the model turn. Managed JuTrack optimizations continue in their
# own process and are never stopped by this setting.
BRILLIANCE_CODEX_INCREMENT_TIMEOUT=1800

# If the model is still planning or writing code without executing a registered
# research program, steer it toward a small reproducible numerical milestone.
# These reminders never interrupt a submitted JuTrack/optimization worker.
BRILLIANCE_FIRST_EXECUTION_NUDGE_S=120
BRILLIANCE_SECOND_EXECUTION_NUDGE_S=300

# This bounds only model preparation before the first saved numerical program
# starts. It never stops JuTrack, tracking, or an optimization worker.
BRILLIANCE_MAX_PRE_EXECUTION_S=180
# Provider-native coding loop: write a short program, run it with JuTrack,
# inspect the numerical receipt, and revise in the same chat turn.
BRILLIANCE_NATIVE_RESEARCH_AGENT=true
BRILLIANCE_NATIVE_AGENT_MODEL_TIMEOUT_S=180
# Per-response output allowance, independent of research/job wall time.
# On truncation, two bounded retries double this allowance up to the ceiling.
# Set BOTH values to fit your provider/model's supported output and context limits.
# Set the ceiling equal to the initial allowance to disable automatic growth.
BRILLIANCE_NATIVE_AGENT_MAX_TOKENS=16384
BRILLIANCE_NATIVE_AGENT_MAX_TOKENS_CEILING=65536
BRILLIANCE_NATIVE_AGENT_STREAM=true
# Optional: request token usage in streaming responses (if supported by endpoint).
BRILLIANCE_NATIVE_AGENT_STREAM_USAGE=false
# Set false only for compatible endpoints that do not implement streaming.
BRILLIANCE_NATIVE_AGENT_STEPS=32

# Bounded agent repair of background Python coding errors (0 disables; maximum 3).
# Does not retry infrastructure failures, physics infeasibility, or cancelled jobs.
BRILLIANCE_AUTO_REPAIR_ATTEMPTS=2

# Completed durable programs return their results to the agent for interpretation
# and the next justified step within the SAME user request. No calculation is
# cancelled when this handoff budget is reached. 0 disables; maximum 32.
BRILLIANCE_RESULT_REVIEW_LIMIT=8

# Publish one durable chat status when the model or a numerical program becomes
# quiet. Distinct scientific milestones, tables, plots, or commentary reset the
# quiet episode. Accepted range: 30-300 seconds.
BRILLIANCE_CHAT_UPDATE_INTERVAL_S=60

# Maximum autonomous increments started for one scientist message. The model
# may finish earlier or request input; another message starts a fresh budget.
BRILLIANCE_RESEARCH_MAX_INCREMENTS=1
BRILLIANCE_RESEARCH_AUTO_CONTINUE=false

# Stop automatic continuation after this many complete time-slice expirations.
# A scientist can inspect the exact failure and send a repair or design change.
BRILLIANCE_MAX_CONSECUTIVE_TIMEOUTS=2

# Refresh elapsed time and bounded model status while a long command is quiet.
BRILLIANCE_PROGRESS_HEARTBEAT=10

# Start a clean model thread before context compaction consumes a research
# increment. Canonical state, code, artifacts, and RESEARCH_HANDOFF.md persist.
BRILLIANCE_CONTEXT_ROLLOVER_RATIO=0.82
